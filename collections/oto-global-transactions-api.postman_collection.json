          "name": "Get Shipping Price Transactions List",
          "request": {
            "name": "Get Shipping Price Transactions List",
            "description": {
              "content": "This API endpoint provides details of your Shipping Price Transactions, calculated based on your configured shipping price settings. By providing either the Order ID or Shipment ID, you can retrieve the shipping cost along with other transactional details. Important Note: The results from this API apply only to shipments created using your configured shipping price contracts. Shipping costs are calculated based on factors such as weight, destination, and other predefined configurations. Request ",
              "type": "text/plain"
            },
